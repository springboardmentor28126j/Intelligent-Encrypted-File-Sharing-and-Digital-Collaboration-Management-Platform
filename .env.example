# ==============================================================================
# TrustShare Environment Configuration
# ==============================================================================

# Core Application
PROJECT_NAME="TrustShare"
VERSION="1.0.0"
API_V1_STR="/api/v1"

# Security & Master Encryption Key (32 bytes hex)
SECRET_KEY="replace-with-a-secure-random-secret-key"
MASTER_KEK="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Relational Database (PostgreSQL)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=trustshare_user
POSTGRES_PASSWORD=trustshare_password
POSTGRES_DB=trustshare_db

# Telemetry & Audit Logs (MongoDB)
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=trustshare_telemetry

# Cache & Rate Limiting (Redis)
REDIS_URI=redis://localhost:6379/0

# Object Storage (local | s3)
STORAGE_TYPE=local
LOCAL_STORAGE_DIR=/tmp/trustshare_storage
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadminpassword
S3_BUCKET_NAME=trustshare-encrypted-files
S3_REGION=us-east-1

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
