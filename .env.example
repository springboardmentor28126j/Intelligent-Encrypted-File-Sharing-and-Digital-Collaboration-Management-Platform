# ==============================================================================
# TrustShare – Environment Configuration Template (.env.example)
# ==============================================================================
# Copy this file to .env or configure in your deployment platform (Docker, AWS, Vercel, Render)
# IMPORTANT: Never commit actual secret keys or credentials to version control.
# ==============================================================================

# ─── FRONTEND CONFIGURATION ───────────────────────────────────────────────────
# Public URL of the FastAPI backend for Next.js browser client calls
NEXT_PUBLIC_API_URL=http://localhost:8000
PORT=3000

# ─── BACKEND DATABASE CONFIGURATION ───────────────────────────────────────────
# Primary Relational DB for Users, Permissions, and Relationships
# Option A: Local SQLite (development default)
DATABASE_URL=sqlite:///./trustshare.db
# Option B: PostgreSQL / Supabase Postgres (Production / Docker)
# DATABASE_URL=postgresql://trustshare:your_secure_db_password@db:5432/trustshare_db

# MongoDB for File Metadata, Audit Logs & Analytics
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB_NAME=trustshare_db

# Redis for Token Revocation, Rate Limiting & Session Caching
REDIS_URL=redis://localhost:6379/0

# ─── SECURITY & ENCRYPTION ────────────────────────────────────────────────────
# JWT Authentication Secret Key (Generate with: openssl rand -hex 32)
SECRET_KEY=change_this_to_a_secure_random_32_byte_secret_key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# AES-256 Envelope Encryption Master Key / Key Encryption Key (KEK)
# 64 hexadecimal characters (32 bytes). Protects all Data Encryption Keys (DEKs).
MASTER_KEY_HEX=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# ─── CLOUD OBJECT STORAGE CONFIGURATION ───────────────────────────────────────
# Storage Backend: "supabase" (Cloud Storage) or "local" (Encrypted Disk Vault)
STORAGE_BACKEND=supabase

# Supabase Storage Credentials (or AWS S3 compatible object store)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_public_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key
SUPABASE_STORAGE_BUCKET=trustshare-files
SUPABASE_SIGNED_URL_EXPIRY_SECONDS=300

# ─── FILE UPLOAD LIMITS & SETTINGS ────────────────────────────────────────────
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=50
ALLOWED_EXTENSIONS=.pdf,.doc,.docx,.txt,.rtf,.odt,.xlsx,.xls,.csv,.pptx,.ppt,.png,.jpg,.jpeg,.gif,.webp,.svg,.bmp,.zip,.tar,.gz,.7z

# ─── CORS & WEB CONFIGURATION ─────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000,http://127.0.0.1:3001

# ─── EMAIL SERVICE (Optional for Password Resets & Share Alerts) ──────────────
EMAIL_PROVIDER=smtp
EMAIL_FROM_ADDRESS=no-reply@trustshare.io
EMAIL_FROM_NAME=TrustShare Security
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_USE_TLS=true
SMTP_USE_SSL=false
