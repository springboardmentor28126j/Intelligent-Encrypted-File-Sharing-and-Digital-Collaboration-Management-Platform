# ── Local Docker Compose values (what docker-compose.yml's services expect) ──
# DATABASE_URL=postgresql://trustshare:trustshare_pw@postgres:5432/trustshare
# MONGO_URL=mongodb://mongo:27017
# REDIS_URL=redis://redis:6379/0

# ── Production values (Supabase + MongoDB Atlas + Upstash) ──
# Supabase: Project Settings -> Database -> Connection string (use the
# Session Pooler one, port 5432, for compatibility with most hosts)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@aws-0-REGION.pooler.supabase.com:5432/postgres

# MongoDB Atlas: Database -> Connect -> Drivers -> copy the
# mongodb+srv:// string, then fill in your password
MONGO_URL=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/trustshare?retryWrites=true&w=majority

# Upstash Redis: dashboard -> your database -> "Redis" tab -> copy the
# rediss:// URL (note the double-s: TLS is required by Upstash)
REDIS_URL=rediss://default:PASSWORD@REGION.upstash.io:PORT

JWT_SECRET=change_this_to_a_long_random_string_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
UPLOAD_DIR=/app/uploads
# 32-byte AES-256 key, base64-encoded. Generate your own for real use with:
#   python -c "import base64, os; print(base64.b64encode(os.urandom(32)).decode())"
MASTER_ENCRYPTION_KEY=change_this_to_your_own_generated_key

# Comma-separated list of frontend origins allowed to call this API.
# Include both your Vercel URL and localhost while testing.
CORS_ORIGINS=http://localhost:3000,https://your-app.vercel.app

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
# Gmail: use an App Password, not your normal account password
SMTP_PASSWORD=your_gmail_app_password
SMTP_FROM_EMAIL=your_email@gmail.com
SMTP_FROM_NAME=TrustShare
FRONTEND_URL=https://your-app.vercel.app

STORAGE_BACKEND=s3
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=ap-south-1
S3_BUCKET_NAME=your-s3-bucket-name
S3_ENDPOINT_URL=
