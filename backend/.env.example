DATABASE_URL=postgresql+psycopg2://postgres:your_password@localhost:5432/trustshare_db

JWT_SECRET_KEY=your_secret_key_here

# Base64 URL-safe encoding of exactly 32 random bytes.
FILE_ENCRYPTION_MASTER_KEY=replace_with_a_32_byte_base64_key

STORAGE_BACKEND=local
AWS_ACCESS_KEY_ID=replace_with_access_key
AWS_SECRET_ACCESS_KEY=replace_with_secret_key
AWS_REGION=us-east-1
AWS_S3_BUCKET=trustshare-private-files
AWS_S3_PREFIX=files
# Optional: only for local S3-compatible testing, not required for AWS.
AWS_ENDPOINT_URL=
SHARE_LINK_BASE_URL=http://localhost:8000/api/share-links

OTP_EXPIRE_MINUTES=10

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password_here
SMTP_FROM_EMAIL=your_email@gmail.com
SMTP_USE_TLS=true