# ─── Database ─────────────────────────────────────────────────────────────────
# Team Common PostgreSQL Database (Supabase Session Pooler):
# DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-ap-southeast-2.pooler.supabase.com:5432/postgres
# Local SQLite fallback (for offline development/tests):
DATABASE_URL=sqlite:///./trustshare.db

# ─── MongoDB Configuration ───────────────────────────────────────────────────
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB_NAME=trustshare_db
# For Docker Compose:
# MONGODB_URL=mongodb://mongo:27017

# ─── Redis Configuration ─────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
# For Docker Compose:
# REDIS_URL=redis://redis:6379/0

# ─── Encryption & Key Management (AES-256-GCM) ──────────────────────────────
# Master Key (KEK) for envelope encryption (32 bytes / 64 hex characters).
# Used to encrypt per-file Data Encryption Keys (DEKs). Never hardcode in source!
MASTER_KEY_HEX=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# ─── Cloud & Object Storage Backend ──────────────────────────────────────────
# Storage backend: "local" (secure encrypted disk storage) or "s3" (AWS S3)
STORAGE_BACKEND=local

# AWS S3 Configuration (Required if STORAGE_BACKEND=s3)
AWS_ACCESS_KEY_ID=your_aws_access_key_id_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key_here
AWS_REGION=us-east-1
AWS_S3_BUCKET_NAME=trustshare-encrypted-files
# Optional custom endpoint (e.g., LocalStack http://localhost:4566 or MinIO):
AWS_S3_ENDPOINT_URL=

# ─── File Upload Limits ──────────────────────────────────────────────────────
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=50
ALLOWED_EXTENSIONS=.pdf,.doc,.docx,.txt,.rtf,.odt,.xlsx,.xls,.csv,.pptx,.ppt,.png,.jpg,.jpeg,.gif,.webp,.svg,.bmp,.zip,.tar,.gz,.7z

# ─── JWT Authentication ───────────────────────────────────────────────────────
SECRET_KEY=supersecretkey_change_in_production_32chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ─── CORS ─────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000,http://127.0.0.1:3001
