# ─── Database ─────────────────────────────────────────────────────────────────
# SQLite (default for local development, zero-setup):
DATABASE_URL=sqlite:///./trustshare.db
# PostgreSQL (for Docker or production):
# DATABASE_URL=postgresql://trustshare:trustshare_secret@localhost:5432/trustshare_db

# ─── MongoDB Configuration ───────────────────────────────────────────────────
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB_NAME=trustshare_db
# For Docker Compose:
# MONGODB_URL=mongodb://mongo:27017

# ─── Redis Configuration ─────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
# For Docker Compose:
# REDIS_URL=redis://redis:6379/0

# ─── File Upload & Storage ───────────────────────────────────────────────────
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=50

# ─── JWT Authentication ───────────────────────────────────────────────────────
SECRET_KEY=supersecretkey_change_in_production_32chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ─── CORS ─────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000,http://127.0.0.1:3001
