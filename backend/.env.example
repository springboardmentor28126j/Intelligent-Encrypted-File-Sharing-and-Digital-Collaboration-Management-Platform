# Copy this file to .env and fill in real values before deploying.

ENV=development

# Postgres in production, e.g.:
# DATABASE_URL=postgresql+psycopg2://trustshare:password@localhost:5432/trustshare
DATABASE_URL=sqlite:///./trustshare.db

JWT_SECRET_KEY=replace-with-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# 32-byte base64 key, e.g. generate with:
#   python -c "import base64,os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
MASTER_ENCRYPTION_KEY=replace-with-a-generated-32-byte-base64-key

STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=./storage/encrypted

# Only needed if STORAGE_BACKEND=s3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET_NAME=

DEFAULT_SHARE_LINK_EXPIRY_HOURS=72
MAX_UPLOAD_SIZE_MB=100

FRONTEND_ORIGIN=http://localhost:3000
