# ─── Database ─────────────────────────────────────────────────────────────────
# Team Common PostgreSQL Database (Supabase Session Pooler):
# DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-ap-southeast-2.pooler.supabase.com:5432/postgres
# Local SQLite fallback (for offline development/tests):
DATABASE_URL=sqlite:///./trustshare.db

# ─── MongoDB Configuration ───────────────────────────────────────────────────
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB_NAME=trustshare_db
# For Docker Compose:
# MONGODB_URL=mongodb://mongo:27017

# ─── Redis Configuration ─────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
# For Docker Compose:
# REDIS_URL=redis://redis:6379/0

# ─── Encryption & Key Management (AES-256-GCM) ──────────────────────────────
# Master Key (KEK) for envelope encryption (32 bytes / 64 hex characters).
# Used to encrypt per-file Data Encryption Keys (DEKs). Never hardcode in source!
MASTER_KEY_HEX=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# ─── Cloud & Object Storage Backend (Supabase Storage) ───────────────────────
# Storage backend: "supabase" (Cloud Storage) or "local" (secure encrypted disk storage)
STORAGE_BACKEND=supabase

# Supabase Storage Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
SUPABASE_STORAGE_BUCKET=trustshare-files
SUPABASE_SIGNED_URL_EXPIRY_SECONDS=300


# ─── File Upload Limits ──────────────────────────────────────────────────────
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=50
ALLOWED_EXTENSIONS=.pdf,.doc,.docx,.txt,.rtf,.odt,.xlsx,.xls,.csv,.pptx,.ppt,.png,.jpg,.jpeg,.gif,.webp,.svg,.bmp,.zip,.tar,.gz,.7z

# ─── JWT Authentication ───────────────────────────────────────────────────────
SECRET_KEY=supersecretkey_change_in_production_32chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ─── Password Reset & Frontend URL ───────────────────────────────────────────
FRONTEND_URL=http://localhost:3000
PASSWORD_RESET_EXPIRE_MINUTES=30

# ─── Email Delivery Service ──────────────────────────────────────────────────
# Provider options: "smtp", "resend", "sendgrid", "console" (logs email to terminal for dev)
EMAIL_PROVIDER=smtp
EMAIL_FROM_ADDRESS=no-reply@trustshare.io
EMAIL_FROM_NAME=TrustShare Security

# SMTP Settings (e.g. Gmail with App Password, SendGrid SMTP, AWS SES)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_16_digit_app_password
SMTP_USE_TLS=true
SMTP_USE_SSL=false

# API Key Providers (if EMAIL_PROVIDER=resend or EMAIL_PROVIDER=sendgrid)
RESEND_API_KEY=re_123456789
SENDGRID_API_KEY=SG.123456789

# ─── CORS ─────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000,http://127.0.0.1:3001

